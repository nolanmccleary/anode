; Tiled matmul: match the fused dot that matmul() lowers to and mint ONE producer
; per tile config (indices into MATMUL_CONFIGS). All configs are semantically
; equivalent (same matmul, different tiling), so unioning them into the op class
; is sound; the genome selects which config enode produces the output, and the
; search profiles each. F32, injective row-major-contiguous output.
(rule
  (
    (= ?out_lt (LayoutTensorLit ?out ?out_layout))
    (= ?out_layout (RightMajorContiguousElementLayoutLit ?out_shape ?bits))
    (= ?out (LogicalReduceSum ?product ?axis))
    (= ?product (LogicalMul ?a ?b))
    (= ?a_lt (LayoutTensorLit ?a ?a_layout))
    (= ?b_lt (LayoutTensorLit ?b ?b_layout))
    (= (dtype-of ?a) (F32))
    (= (dtype-of ?b) (F32))
    (= (dtype-of ?out) (F32))
    (= (injectivity-of ?out_lt) (Injective))
  )
  (
    (let ?op (LayoutTensorOpLit
      (LayoutTensorCons ?a_lt (LayoutTensorCons ?b_lt (LayoutTensorNil)))
      (LayoutTensorCons ?out_lt (LayoutTensorNil))))
    (union ?op (LayoutTensorOpMatmulTiledGeneric ?a_lt ?b_lt ?out_layout 0))
    (union ?op (LayoutTensorOpMatmulTiledGeneric ?a_lt ?b_lt ?out_layout 1))
    (union ?op (LayoutTensorOpMatmulTiledGeneric ?a_lt ?b_lt ?out_layout 2))
    (union ?op (LayoutTensorOpMatmulTiledGeneric ?a_lt ?b_lt ?out_layout 3))
  )
  :ruleset backend
  :name "metal/matmul_tiled/match: tiled matmul, one producer per tile config"
)
