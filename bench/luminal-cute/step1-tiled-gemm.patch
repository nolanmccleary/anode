 pub(crate) fn reduce_product(ctx: &CodegenCtx, axis_from_end: usize) -> Result<Vec<KernelSource>> {
+    // Fast path: the fused multiply/reduce that the `matmul()` lowering produces
+    // is a GEMM. Emit a tiled `simdgroup_matrix` kernel when the geometry is the
+    // clean 2D case; otherwise fall back to the general scalar loop below.
+    if let Some(tiled) = matmul_simdgroup(ctx, axis_from_end)? {
+        return Ok(tiled);
+    }
     reduce_impl(ctx, axis_from_end, "0.0f", "acc + v", true)
 }
 
+/// Tiled GEMM via Metal `simdgroup_matrix` (8x8 cooperative tiles) for the clean
+/// 2D matmul that `MulReduceSum` reduces to:
+///   out[m,n] = sum_k A[m,k] * B[n,k]   (i.e. C = A @ B^T, the `matmul()` form).
+///
+/// Returns `None` (fall back to the naive loop, which is correct for every case)
+/// unless every precondition the hardcoded tile addressing relies on holds: F32
+/// throughout, a rank-3 product reduced over the innermost (K) axis to a rank-2
+/// output, static dims divisible by 8, and operands laid out as
+/// broadcast-of-row-major with a unit K stride. The egglog match rule already
+/// guarantees an injective, row-major-contiguous F32 output; these checks
+/// additionally pin the input geometry the tiles assume.
+fn matmul_simdgroup(ctx: &CodegenCtx, axis_from_end: usize) -> Result<Option<Vec<KernelSource>>> {
+    if axis_from_end != 0 || ctx.operand_dims.len() < 2 {
+        return Ok(None);
+    }
+    let in_dims = &ctx.operand_dims[0];
+    if in_dims.len() != 3 || ctx.operand_dims[1] != *in_dims || ctx.dest_dims[0].len() != 2 {
+        return Ok(None);
+    }
+    if ctx.operand_dtypes[0] != PlanDtype::F32
+        || ctx.operand_dtypes[1] != PlanDtype::F32
+        || ctx.dest_dtypes[0] != PlanDtype::F32
+    {
+        return Ok(None);
+    }
+    // Static, tile-aligned extents (M, N, K over the product shape [M, N, K]).
+    let lit = |e: &Expr| e.literal().and_then(|v| usize::try_from(v).ok());
+    let (Some(m), Some(n), Some(k)) = (lit(&in_dims[0]), lit(&in_dims[1]), lit(&in_dims[2])) else {
+        return Ok(None);
+    };
+    if m == 0 || n == 0 || k == 0 || m % 8 != 0 || n % 8 != 0 || k % 8 != 0 {
+        return Ok(None);
+    }
+    // Operand geometry via numeric strides: A broadcast over N -> coeffs
+    // [lda, 0, 1]; B broadcast over M -> coeffs [0, ldb, 1]. Unit K stride is
+    // required for `simdgroup_load` (contiguous within a loaded row).
+    let dims = [m, n, k];
+    let (Some(a_aff), Some(b_aff)) = (
+        read_affine(ctx.operand_layout(0), &dims),
+        read_affine(ctx.operand_layout(1), &dims),
+    ) else {
+        return Ok(None);
+    };
+    if a_aff.constant != 0 || b_aff.constant != 0 {
+        return Ok(None);
+    }
+    let (lda, ldb) = (a_aff.coeffs[0], b_aff.coeffs[1]);
+    let a_ok = a_aff.coeffs[1] == 0 && a_aff.coeffs[2] == 1 && lda > 0;
+    let b_ok = b_aff.coeffs[0] == 0 && b_aff.coeffs[2] == 1 && ldb > 0;
+    if !a_ok || !b_ok {
+        return Ok(None);
+    }
+    let ldc = n as i64; // row-major [M, N] output, guaranteed by the match rule
+
+    // One simdgroup (32 threads) computes one 8x8 output tile, looping over K.
+    let source = format!(
+        r#"#include <metal_stdlib>
+using namespace metal;
+kernel void k(device const float* a, device const float* b, device float* out,
+              device const long* params,
+              uint2 tg [[threadgroup_position_in_grid]]) {{
+    const uint n0 = tg.x * 8u;
+    const uint m0 = tg.y * 8u;
+    simdgroup_float8x8 acc = make_filled_simdgroup_matrix<float, 8, 8>(0.0f);
+    for (uint k0 = 0u; k0 < {k}u; k0 += 8u) {{
+        simdgroup_float8x8 at, bt;
+        simdgroup_load(at, a + (ulong)m0 * {lda} + k0, {lda});
+        simdgroup_load(bt, b + (ulong)n0 * {ldb} + k0, {ldb}, ulong2(0), true);
+        simdgroup_multiply_accumulate(acc, at, bt, acc);
+    }}
+    simdgroup_store(acc, out + (ulong)m0 * {ldc} + n0, {ldc});
+}}"#
+    );
+
+    let launch = KernelLaunch {
+        grid: [(n / 8).into(), (m / 8).into(), 1usize.into()],
+        block: [32usize.into(), 1usize.into(), 1usize.into()],
+        shared_bytes: 0usize.into(),
+    };
+    Ok(Some(vec![KernelSource {
+        source,
+        n: (m * n).into(),
+        launch: Some(launch),
+    }]))
+}
+
 fn reduce_impl(
     ctx: &CodegenCtx,
     axis_from_end: usize,
