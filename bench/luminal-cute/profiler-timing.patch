+/// Untimed back-to-back executes to ramp the GPU clocks before measuring.
+const STEADY_WARMUP: usize = 3;
+/// Minimum number of timed reps for a stable min (default path uses `trials`).
+const STEADY_MIN_REPS: usize = 30;
+/// Samples before the early-stop check may fire (give the min a chance to settle).
+const STEADY_EARLY_MIN: usize = 8;
+
+/// Steady-state cost = MIN over many back-to-back executes with the GPU warmed
+/// and pipelined. Unlike the default path (MEAN of single-shot wall-clock executes,
+/// re-initializing inputs each trial), this does not re-init between reps, so the
+/// kernels run back-to-back and sustained throughput — where tile-config variants
+/// actually differ — becomes visible. The returned `mean_nanos` field carries the
+/// min. Inputs are assumed data-independent in timing (true for GEMM and friends).
+fn profile_steady_state(
+    device: &mut MetalExecutable,
+    arena: &Buffer,
+    dims: &luminal::shape::DynMap,
+    trials: usize,
+    best_so_far: Option<u128>,
+    candidate_timeout: Option<Duration>,
+    use_gpu_timestamp: bool,
+) -> Result<Measurement, ProfileFailure> {
+    for _ in 0..STEADY_WARMUP {
+        device.execute(arena, dims).map_err(ProfileFailure::Execute)?;
+    }
+    let reps = trials.max(STEADY_MIN_REPS);
+    let mut best = u128::MAX;
+    let mut elapsed_total = 0u128;
+    for rep in 0..reps {
+        let start = Instant::now();
+        device.execute(arena, dims).map_err(ProfileFailure::Execute)?;
+        let wall = start.elapsed().as_nanos();
+        // GPU-timestamp mode costs the on-GPU span (no CPU encode/submit/sync);
+        // wall-clock drives the timeout/early-stop bookkeeping either way.
+        let dt = if use_gpu_timestamp {
+            device.last_gpu_nanos().unwrap_or(wall)
+        } else {
+            wall
+        };
+        best = best.min(dt);
+        elapsed_total += wall;
+        if candidate_timeout.is_some_and(|budget| elapsed_total > budget.as_nanos()) {
+            return Ok(Measurement::TimedOut {
+                elapsed_nanos: elapsed_total,
+                completed_trials: rep + 1,
+            });
+        }
+        // Once the min has had a chance to settle, abandon a candidate whose very
+        // best is already worse than the incumbent — it cannot win.
+        if rep + 1 >= STEADY_EARLY_MIN
+            && best_so_far.is_some_and(|incumbent| early_stop_exceeded(best, incumbent, 1.0))
+        {
+            return Ok(Measurement::Timed {
+                mean_nanos: best,
+                completed_trials: rep + 1,
+            });
+        }
+    }
+    Ok(Measurement::Timed {
+        mean_nanos: best,
+        completed_trials: reps,
+    })
+}
