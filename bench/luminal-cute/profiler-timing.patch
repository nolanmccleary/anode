+
+/// Read a command buffer's on-GPU execution span via `GPUStartTime`/`GPUEndTime`
+/// (metal-0.31 does not bind these, so message them directly). Returns `None` if
+/// the device did not report valid timestamps.
+fn command_buffer_gpu_nanos(command: &metal::CommandBufferRef) -> Option<u128> {
+    use metal::foreign_types::ForeignTypeRef;
+    use objc::{msg_send, runtime::Object, sel, sel_impl};
+    let obj = command.as_ptr() as *mut Object;
+    if obj.is_null() {
+        return None;
+    }
+    let start: f64 = unsafe { msg_send![obj, GPUStartTime] };
+    let end: f64 = unsafe { msg_send![obj, GPUEndTime] };
+    if end.is_finite() && start.is_finite() && end > start {
+        Some(((end - start) * 1e9) as u128)
+    } else {
+        None
+    }
 }
