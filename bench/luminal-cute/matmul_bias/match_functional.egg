; Fuse  out = (A @ B^T) + bias  into a single kernel, avoiding a global-memory
; round-trip of the M*N matmul intermediate. Matches the fused dot that matmul()
; lowers to, wrapped in an elementwise add. F32 only (same rounding as the
; decomposed {MulReduceSum; Add} plan; no reassociation beyond the matmul's own).
; The unfused plan always remains available, so this is a pure optimization the
; search elects only when it profiles faster.
(rule
  (
    (= ?out_lt (LayoutTensorLit ?out ?out_layout))
    (= ?out_layout (RightMajorContiguousElementLayoutLit ?out_shape ?bits))
    (= ?out (LogicalAdd ?mm ?bias))
    (= ?mm (LogicalReduceSum ?product ?axis))
    (= ?product (LogicalMul ?a ?b))
    (= ?a_lt (LayoutTensorLit ?a ?a_layout))
    (= ?b_lt (LayoutTensorLit ?b ?b_layout))
    (= ?bias_lt (LayoutTensorLit ?bias ?bias_layout))
    (= (dtype-of ?a) (F32))
    (= (dtype-of ?b) (F32))
    (= (dtype-of ?bias) (F32))
    (= (dtype-of ?out) (F32))
    (= (injectivity-of ?out_lt) (Injective))
  )
  (
    (let ?op (LayoutTensorOpLit
      (LayoutTensorCons ?a_lt
        (LayoutTensorCons ?b_lt
          (LayoutTensorCons ?bias_lt (LayoutTensorNil))))
      (LayoutTensorCons ?out_lt (LayoutTensorNil))))
    (union ?op
      (LayoutTensorOpMatmulBiasGeneric ?a_lt ?b_lt ?bias_lt ?axis ?out_layout))
  )
  :ruleset backend
  :name "metal/matmul_bias/match_functional: Fused matmul + bias add, F32 only"
)
