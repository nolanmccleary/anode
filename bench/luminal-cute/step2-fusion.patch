 pub(crate) fn reduce_product(ctx: &CodegenCtx, axis_from_end: usize) -> Result<Vec<KernelSource>> {
+    // Fast path: the fused multiply/reduce that the `matmul()` lowering produces
+    // is a GEMM. Emit a tiled `simdgroup_matrix` kernel when the geometry is the
+    // clean 2D case; otherwise fall back to the general scalar loop below.
+    if let Some(tiled) = matmul_simdgroup(ctx, axis_from_end)? {
+        return Ok(tiled);
+    }
     reduce_impl(ctx, axis_from_end, "0.0f", "acc + v", true)
 }
 
+/// A dense 2D CuTe layout `[rows, cols] : [row_stride, 1]`, used to GENERATE
+/// GEMM tile addressing through `cute_msl` (`crd2idx` = `coord . stride`).
+fn gemm_layout(rows: usize, cols: usize, row_stride: i64) -> cute_layout::layout::Layout {
+    use cute_layout::tuple::IntTuple::{Leaf, Tuple};
+    cute_layout::layout::Layout::new(
+        Tuple(vec![Leaf(rows as i64), Leaf(cols as i64)]),
+        Tuple(vec![Leaf(row_stride), Leaf(1)]),
+    )
+}
+
+/// Tiled GEMM via Metal `simdgroup_matrix` (8x8 cooperative tiles) for the clean
+/// 2D matmul that `MulReduceSum` reduces to:
+///   out[m,n] = sum_k A[m,k] * B[n,k]   (i.e. C = A @ B^T, the `matmul()` form).
+///
+/// Returns `None` (fall back to the naive loop, which is correct for every case)
+/// unless every precondition the hardcoded tile addressing relies on holds: F32
+/// throughout, a rank-3 product reduced over the innermost (K) axis to a rank-2
+/// output, static dims divisible by 8, and operands laid out as
+/// broadcast-of-row-major with a unit K stride. The egglog match rule already
+/// guarantees an injective, row-major-contiguous F32 output; these checks
+/// additionally pin the input geometry the tiles assume.
+fn matmul_simdgroup(ctx: &CodegenCtx, axis_from_end: usize) -> Result<Option<Vec<KernelSource>>> {
+    if axis_from_end != 0 || ctx.operand_dims.len() < 2 {
+        return Ok(None);
+    }
+    let in_dims = &ctx.operand_dims[0];
+    if in_dims.len() != 3 || ctx.operand_dims[1] != *in_dims || ctx.dest_dims[0].len() != 2 {
+        return Ok(None);
+    }
+    if ctx.operand_dtypes[0] != PlanDtype::F32
+        || ctx.operand_dtypes[1] != PlanDtype::F32
+        || ctx.dest_dtypes[0] != PlanDtype::F32
+    {
+        return Ok(None);
+    }
+    // Static, tile-aligned extents (M, N, K over the product shape [M, N, K]).
+    let lit = |e: &Expr| e.literal().and_then(|v| usize::try_from(v).ok());
+    let (Some(m), Some(n), Some(k)) = (lit(&in_dims[0]), lit(&in_dims[1]), lit(&in_dims[2])) else {
+        return Ok(None);
+    };
+    if m == 0 || n == 0 || k == 0 || m % 8 != 0 || n % 8 != 0 || k % 8 != 0 {
+        return Ok(None);
+    }
+    // Operand geometry via numeric strides: A broadcast over N -> coeffs
+    // [lda, 0, 1]; B broadcast over M -> coeffs [0, ldb, 1]. Unit K stride is
+    // required for `simdgroup_load` (contiguous within a loaded row).
+    let dims = [m, n, k];
+    let (Some(a_aff), Some(b_aff)) = (
+        read_affine(ctx.operand_layout(0), &dims),
+        read_affine(ctx.operand_layout(1), &dims),
+    ) else {
+        return Ok(None);
+    };
+    if a_aff.constant != 0 || b_aff.constant != 0 {
+        return Ok(None);
+    }
+    let (lda, ldb) = (a_aff.coeffs[0], b_aff.coeffs[1]);
+    let a_ok = a_aff.coeffs[1] == 0 && a_aff.coeffs[2] == 1 && lda > 0;
+    let b_ok = b_aff.coeffs[0] == 0 && b_aff.coeffs[2] == 1 && ldb > 0;
+    if !a_ok || !b_ok {
+        return Ok(None);
+    }
+    let ldc = n as i64; // row-major [M, N] output, guaranteed by the match rule
+
+    // Addressing is GENERATED from CuTe layouts via cute_msl (not hand-written):
+    // A[M,K]:[lda,1], B[N,K]:[ldb,1], C[M,N]:[ldc,1]. The tile-origin / loop
+    // coords (m0,n0,k0) are ulong so the crd2idx offsets are 64-bit.
+    let a_off = crate::cute_msl::layout_offset(&gemm_layout(m, k, lda), &["m0", "k0"]);
+    let b_off = crate::cute_msl::layout_offset(&gemm_layout(n, k, ldb), &["n0", "k0"]);
+    let c_off = crate::cute_msl::layout_offset(&gemm_layout(m, n, ldc), &["m0", "n0"]);
+
+    // One simdgroup (32 threads) computes one 8x8 output tile, looping over K.
+    let source = format!(
+        r#"#include <metal_stdlib>
+using namespace metal;
+kernel void k(device const float* a, device const float* b, device float* out,
+              device const long* params,
+              uint2 tg [[threadgroup_position_in_grid]]) {{
+    ulong n0 = (ulong)tg.x * 8;
+    ulong m0 = (ulong)tg.y * 8;
+    simdgroup_float8x8 acc = make_filled_simdgroup_matrix<float, 8, 8>(0.0f);
+    for (ulong k0 = 0; k0 < {k}; k0 += 8) {{
+        simdgroup_float8x8 at, bt;
+        simdgroup_load(at, a + {a_off}, {lda});
+        simdgroup_load(bt, b + {b_off}, {ldb}, ulong2(0), true);
+        simdgroup_multiply_accumulate(acc, at, bt, acc);
+    }}
+    simdgroup_store(acc, out + {c_off}, {ldc});
+}}"#
+    );
+
+    let launch = KernelLaunch {
+        grid: [(n / 8).into(), (m / 8).into(), 1usize.into()],
+        block: [32usize.into(), 1usize.into(), 1usize.into()],
+        shared_bytes: 0usize.into(),
+    };
+    Ok(Some(vec![KernelSource {
+        source,
+        n: (m * n).into(),
+        launch: Some(launch),
+    }]))
+}
+
+/// Static geometry of a fused matmul+bias: C[m,n] = sum_k A[m,k]*B[n,k] +
+/// bias[m,n], with A/B as broadcast-of-row-major (coeffs [lda,0,1] / [0,ldb,1])
+/// and a general bias layout (coeffs [bias_sm, bias_sn], supporting a full
+/// [M,N] bias or a broadcast [N]/[M] bias). Returns None for anything the fused
+/// kernels do not handle (dynamic dims, non-F32, wrong geometry) — the caller
+/// bails and the search keeps the always-available UNFUSED plan.
+struct MatmulBiasGeom {
+    m: usize,
+    n: usize,
+    k: usize,
+    lda: i64,
+    ldb: i64,
+    bias_sm: i64,
+    bias_sn: i64,
+}
+
+fn matmul_bias_geom(ctx: &CodegenCtx) -> Option<MatmulBiasGeom> {
+    // Operands: [a, b, bias, dest0]. a/b are the broadcast matmul inputs over
+    // [M,N,K]; bias is [M,N]; the output is row-major [M,N].
+    if ctx.operand_dims.len() < 3 {
+        return None;
+    }
+    let a_dims = &ctx.operand_dims[0];
+    let bias_dims = &ctx.operand_dims[2];
+    if a_dims.len() != 3 || ctx.operand_dims[1] != *a_dims || bias_dims.len() != 2 {
+        return None;
+    }
+    if ctx.operand_dtypes[0] != PlanDtype::F32
+        || ctx.operand_dtypes[1] != PlanDtype::F32
+        || ctx.operand_dtypes[2] != PlanDtype::F32
+        || ctx.dest_dtypes[0] != PlanDtype::F32
+    {
+        return None;
+    }
+    let lit = |e: &Expr| e.literal().and_then(|v| usize::try_from(v).ok());
+    let (m, n, k) = (lit(&a_dims[0])?, lit(&a_dims[1])?, lit(&a_dims[2])?);
+    if m == 0 || n == 0 || k == 0 {
+        return None;
+    }
+    if lit(&bias_dims[0])? != m || lit(&bias_dims[1])? != n {
+        return None;
+    }
+    let a_aff = read_affine(ctx.operand_layout(0), &[m, n, k])?;
+    let b_aff = read_affine(ctx.operand_layout(1), &[m, n, k])?;
+    let bias_aff = read_affine(ctx.operand_layout(2), &[m, n])?;
+    if a_aff.constant != 0 || b_aff.constant != 0 || bias_aff.constant != 0 {
+        return None;
+    }
+    let (lda, ldb) = (a_aff.coeffs[0], b_aff.coeffs[1]);
+    if a_aff.coeffs[1] != 0 || a_aff.coeffs[2] != 1 || lda <= 0 {
+        return None;
+    }
+    if b_aff.coeffs[0] != 0 || b_aff.coeffs[2] != 1 || ldb <= 0 {
+        return None;
+    }
+    Some(MatmulBiasGeom {
+        m,
+        n,
+        k,
+        lda,
+        ldb,
+        bias_sm: bias_aff.coeffs[0],
+        bias_sn: bias_aff.coeffs[1],
+    })
+}
+
+/// Verify the GEMM+bias tile geometry with the CuTe layout algebra
+/// (`cute_layout`). A, B, and the output D are modeled as CuTe (shape:stride)
+/// `Layout`s; the 8x8 simdgroup tiling is checked for admissibility: K/column
+/// unit stride where the simdgroup load/store reads contiguously, even division
+/// of every axis by the 8x8 tile, and agreement between CuTe's per-tile base
+/// offset and the kernel's own addressing. This is the seam where a CuTe IR
+/// owns the tiling — the hand-emitted kernel's constants are cross-checked
+/// against the layout algebra instead of trusted. A failure rejects this
+/// candidate (the unfused plan remains).
+fn cute_verify_gemm_tiling(
+    m: usize,
+    n: usize,
+    k: usize,
+    lda: i64,
+    ldb: i64,
+    ldc: i64,
+) -> Result<()> {
+    use cute_layout::layout::Layout;
+    use cute_layout::tuple::IntTuple;
+    let pair = |a: i64, b: i64| IntTuple::Tuple(vec![IntTuple::Leaf(a), IntTuple::Leaf(b)]);
+    let (mi, ni, ki) = (m as i64, n as i64, k as i64);
+
+    let d = Layout::new(pair(mi, ni), pair(ldc, 1)); // D[m,n] row-major
+    let a = Layout::new(pair(mi, ki), pair(lda, 1)); // A[m,k], K unit-stride
+    let b = Layout::new(pair(ni, ki), pair(ldb, 1)); // B[n,k], K unit-stride
+
+    // Unit stride along the contiguous axis of a simdgroup load/store.
+    let unit_second = |l: &Layout| l.call(&pair(0, 1)) - l.call(&pair(0, 0)) == 1;
+    anyhow::ensure!(
+        unit_second(&a),
+        "CuTe: A is not K-contiguous (simdgroup_load needs unit stride)"
+    );
+    anyhow::ensure!(unit_second(&b), "CuTe: B is not K-contiguous");
+    anyhow::ensure!(
+        unit_second(&d),
+        "CuTe: D columns are not contiguous (simdgroup_store)"
+    );
+    // The 8x8 tiler must divide every axis.
+    anyhow::ensure!(
+        m % 8 == 0 && n % 8 == 0 && k % 8 == 0,
+        "CuTe: 8x8 tiler does not divide M/N/K"
+    );
+    // CuTe's per-tile base offset must equal the kernel's `m0*ldc + n0`.
+    for &(ti, tj) in &[(0i64, 0i64), (1, 0), (0, 1), (mi / 8 - 1, ni / 8 - 1)] {
+        let (m0, n0) = (ti * 8, tj * 8);
+        let cute_off = d.call(&pair(m0, n0));
+        anyhow::ensure!(
+            cute_off == m0 * ldc + n0,
+            "CuTe: tile ({m0},{n0}) offset {cute_off} != kernel {}",
+            m0 * ldc + n0
+        );
+    }
+    Ok(())
+}
+
+/// Fused GEMM + bias epilogue (Step 2). Emits a tiled `simdgroup_matrix` kernel
+/// that applies the bias to each 8x8 output tile BEFORE the global store — so
+/// the M*N matmul intermediate never round-trips global memory, unlike the
+/// unfused {matmul kernel; add kernel} plan. The 8x8-aligned tiled path is used
+/// when M,N,K are all divisible by 8; otherwise a per-element fused kernel keeps
+/// correctness. Returns an error only for geometry the match rule should have
+/// excluded, which rejects this candidate and leaves the unfused plan.
+pub(crate) fn matmul_bias_codegen(ctx: &CodegenCtx) -> Result<Vec<KernelSource>> {
+    let g = matmul_bias_geom(ctx).ok_or_else(|| {
+        anyhow::anyhow!("fused matmul+bias requires static F32 broadcast-row-major geometry")
+    })?;
+    let MatmulBiasGeom {
+        m,
+        n,
+        k,
+        lda,
+        ldb,
+        bias_sm,
+        bias_sn,
+    } = g;
+    let ldc = n as i64;
+
+    if m % 8 == 0 && n % 8 == 0 && k % 8 == 0 {
+        // CuTe owns the tiling: model A/B/D as (shape:stride) layouts and verify
+        // the 8x8 tile geometry is admissible for the simdgroup load/store the
+        // kernel emits. This is the Luminal->CuTe seam in miniature — the kernel
+        // constants are cross-checked against the layout algebra, not trusted.
+        cute_verify_gemm_tiling(m, n, k, lda, ldb, ldc)?;
+        // Addressing GENERATED from CuTe layouts via cute_msl: A/B loads over
+        // (m0/n0, k0), and the epilogue bias read + output write over (mm, nn).
+        // The bias layout `[M,N]:[bias_sm,bias_sn]` lets a broadcast [N]/[M] bias
+        // drop its zero-stride axis automatically.
+        let a_off = crate::cute_msl::layout_offset(&gemm_layout(m, k, lda), &["m0", "k0"]);
+        let b_off = crate::cute_msl::layout_offset(&gemm_layout(n, k, ldb), &["n0", "k0"]);
+        let c_off = crate::cute_msl::layout_offset(&gemm_layout(m, n, ldc), &["mm", "nn"]);
+        let bias_off = {
+            use cute_layout::tuple::IntTuple::{Leaf, Tuple};
+            let bias_layout = cute_layout::layout::Layout::new(
+                Tuple(vec![Leaf(m as i64), Leaf(n as i64)]),
+                Tuple(vec![Leaf(bias_sm), Leaf(bias_sn)]),
+            );
+            crate::cute_msl::layout_offset(&bias_layout, &["mm", "nn"])
+        };
+        // Tiled: one simdgroup computes an 8x8 C tile, stores it to threadgroup
+        // memory, then the 32 threads add bias and write out (the fused epilogue).
+        let source = format!(
+            r#"#include <metal_stdlib>
+using namespace metal;
+kernel void k(device const float* a, device const float* b, device const float* bias,
+              device float* out, device const long* params,
+              uint2 tg [[threadgroup_position_in_grid]],
+              uint lid [[thread_index_in_threadgroup]]) {{
+    ulong n0 = (ulong)tg.x * 8;
+    ulong m0 = (ulong)tg.y * 8;
+    simdgroup_float8x8 acc = make_filled_simdgroup_matrix<float, 8, 8>(0.0f);
+    for (ulong k0 = 0; k0 < {k}; k0 += 8) {{
+        simdgroup_float8x8 at, bt;
+        simdgroup_load(at, a + {a_off}, {lda});
+        simdgroup_load(bt, b + {b_off}, {ldb}, ulong2(0), true);
+        simdgroup_multiply_accumulate(acc, at, bt, acc);
+    }}
+    threadgroup float tile[64];
+    simdgroup_store(acc, tile, 8);
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    for (uint e = lid; e < 64u; e += 32u) {{
+        ulong mm = m0 + (ulong)(e / 8u), nn = n0 + (ulong)(e % 8u);
+        float v = tile[e] + bias[{bias_off}];
+        out[{c_off}] = v;
+    }}
+}}"#
+        );
+        let launch = KernelLaunch {
+            grid: [(n / 8).into(), (m / 8).into(), 1usize.into()],
+            block: [32usize.into(), 1usize.into(), 1usize.into()],
+            shared_bytes: 0usize.into(),
+        };
+        return Ok(vec![KernelSource {
+            source,
+            n: (m * n).into(),
+            launch: Some(launch),
+        }]);
+    }
+
+    // Per-element fused fallback (still one kernel, still no round-trip).
+    let source = format!(
+        r#"kernel void k(device const float* a, device const float* b, device const float* bias,
+              device float* out, device const long* params, uint gid [[thread_position_in_grid]]) {{
+    const ulong MN = {mn};
+    ulong i = gid;
+    if (i >= MN) return;
+    ulong m = i / {n};
+    ulong nn = i % {n};
+    float acc = 0.0f;
+    for (ulong kk = 0; kk < {k}; ++kk) {{
+        acc += a[m * {lda} + kk] * b[nn * {ldb} + kk];
+    }}
+    out[i] = acc + bias[m * {bias_sm} + nn * {bias_sn}];
+}}"#,
+        mn = m * n,
+    );
+    Ok(vec![KernelSource::plain(source, (m * n).into())])
+}
